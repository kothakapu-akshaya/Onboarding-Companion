COMPOSE_PROFILES=local

# Object Storage Configuration
HZ_OBJ_ACCESS_KEY="minioadmin"
HZ_OBJ_SECRET_KEY="minioadmin"
HZ_OBJ_ENDPOINT="http://localhost:9000"
HZ_OBJ_BUCKET_NAME="indic-corpus-bucket"
HZ_OBJ_USE_SSL="false"


# Database Configuration
PROJECT_NAME="Indic Corpus Server"

# SQLite (comment out when using PostgreSQL)
# DATABASE_URL="sqlite:///./corpus_te.db"

# PostgreSQL Configuration
DB_NAME=indic_corpus
DB_PORT=5432               # PostgreSQL port (change when running python app outside Docker and postgres service is exposed on a different port)
DB_USER=postgres            # PostgreSQL username
DB_PASSWORD=postgres        # PostgreSQL password (change in production)
DB_HOST=postgres            # Use 'localhost' when running python app outside Docker

# CORS Origins (comma-separated for production)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# JWT Configuration (change in production)
APP_SECRET_KEY="your_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL="WARNING"

# File Upload Settings
MAX_FILE_SIZE=104857600  # 100MB in bytes

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=300

# Redis Configuration (if separate from Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

MINIO_DEFAULT_BUCKETS=indic-corpus-bucket
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_CONFIG_SERVER_MODE=False
